{
  "name": "amxx-builder",
  "version": "1.5.2",
  "author": {
    "name": "ArKaNeMaN"
  },
  "description": "CLI tool to build and package AMX Mod X server plugins",
  "repository": {
    "url": "git+https://github.com/AmxxModularEcosystem/amxx-builder.git"
  },
  "keywords": [
    "amxx",
    "amxmodx",
    "cs",
    "hlds",
    "builder",
    "amxx-builder",
    "amxb",
    "mcp",
    "amxbuild",
    "half-life"
  ],
  "main": "index.js",
  "bin": {
    "amxx-builder": "index.js",
    "amxb": "index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "bundle": "esbuild action-entry.js --bundle --platform=node --target=node24 --format=cjs --minify --legal-comments=inline --outfile=dist/index.js && node scripts/gen-licenses.js"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "adm-zip": "^0.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "archiver": "^7.0.1",
    "axios": "^1.7.2",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "enquirer": "^2.4.1",
    "fast-glob": "^3.3.2",
    "js-yaml": "^4.3.1",
    "simple-git": "^3.22.0"
  },
  "files": [
    "index.js",
    "mcp/",
    "src/",
    "action.yml",
    "action-entry.js",
    "templates/",
    "defaults/",
    "package.json",
    "README.md",
    "AGENTS.md"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
