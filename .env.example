GITHUB_TOKEN=ghp_your_token_here

# ── Deploy ────────────────────────────────────────────────────────────────────
# Used by: amxb deploy, amxb watch

# Server root directory — files are deployed relative to this path
# Example: /home/user/hlds/cstrike  or  C:\hlds\cstrike
AMXB_DEPLOY_PATH=

# GoldSrc UDP RCON — leave blank to skip RCON after deploy
AMXB_DEPLOY_RCON_HOST=127.0.0.1
AMXB_DEPLOY_RCON_PORT=27015
AMXB_DEPLOY_RCON_PASSWORD=
# {plugin} is replaced with the plugin name (without .amxx extension)
# Leave blank to disable RCON commands
AMXB_DEPLOY_RCON_CMD=amxx load {plugin}

# ── Plugins debug (local only) ────────────────────────────────────────────────
# Read from this .env file next to the manifest — .env is gitignored and never
# committed, so this override stays purely local.
# Forces the " debug" suffix in generated plugins-*.ini for every plugin entry,
# overriding any debug set in the manifest:
#   1 / true / yes / on    → force debug ON
#   0 / false / no / off   → force debug OFF
#   blank / other          → no override (the manifest decides)
# Precedence: AMXB_PLUGINS_DEBUG > per-rule/per-repo debug > plugins.defaults.debug.
# Only affects plugins already included in an INI; does not enable INI generation.
AMXB_PLUGINS_DEBUG=
