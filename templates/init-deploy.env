# amxx-builder deploy configuration
# Used by: amxb deploy, amxb watch

# Server root directory — files are deployed relative to this path
# Example: /home/user/hlds/cstrike  or  C:\hlds\cstrike
AMXB_DEPLOY_PATH=

# GoldSrc UDP RCON — leave blank to skip RCON after deploy
AMXB_DEPLOY_RCON_HOST=127.0.0.1
AMXB_DEPLOY_RCON_PORT=27015
AMXB_DEPLOY_RCON_PASSWORD=
# {plugin} is replaced with the plugin name (without .amxx extension)
# Leave blank to disable RCON commands
AMXB_DEPLOY_RCON_CMD=amxx load {plugin}

# Plugins debug (local only) — this .env is gitignored, never committed
# Forces " debug" in generated plugins-*.ini for every plugin entry:
#   1 / true / yes / on  → force ON
#   0 / false / no / off → force OFF
#   blank / other        → no override (manifest decides)
# Overrides per-rule/per-repo debug and plugins.defaults.debug; only affects
# plugins already included in an INI (does not enable INI generation).
AMXB_PLUGINS_DEBUG=

# RPC-инструменты MCP (опционально) — управление живым AMX Mod X сервером
# через модуль amxx-rpc-module. Без AMXB_RPC_TOKEN инструменты скрыты.
# Настройки читает MCP-сервер (amxb mcp); деплой их не использует.

# Хост RPC-эндпоинта (по умолчанию 127.0.0.1).
# Для доступа из WSL задайте host = 0.0.0.0 в amxxrpc.cfg и IP Windows-хоста здесь.
AMXB_RPC_HOST=127.0.0.1

# TCP-порт модуля (по умолчанию 27016).
# ВНИМАНИЕ: это собственный порт модуля, отдельный от игрового/RCon 27015.
AMXB_RPC_PORT=27016

# Общий секрет (не короче 16 символов), совпадает с token в
# addons/amxmodx/configs/amxxrpc.cfg. Без него RPC-инструменты скрыты.
AMXB_RPC_TOKEN=

# Таймаут одного запроса и установки соединения в секундах (по умолчанию 15).
AMXB_RPC_TIMEOUT=15

# Явный тумблер: 1/true/yes/on — включить, 0/false/no/off — принудительно
# скрыть инструменты даже при заданном токене. Пусто — решает наличие токена.
AMXB_RPC_ENABLED=
